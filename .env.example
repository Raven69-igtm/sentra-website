APP_NAME=SENTRA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sentra.pbltifnganjuk.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sentra
DB_USERNAME=sentra_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Keamanan API & Sanctum
CORS_ALLOWED_ORIGINS=https://sentra.pbltifnganjuk.com
SANCTUM_STATEFUL_DOMAINS=sentra.pbltifnganjuk.com
# Masa berlaku token Sanctum dalam menit (default 43200 = 30 hari)
SANCTUM_TOKEN_EXPIRATION=43200

# Firebase Cloud Messaging (HTTP v1)
FIREBASE_PROJECT_ID=sentra-3e7a6
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# WebSocket Server (Node.js websocket-server.cjs)
WS_HOST=127.0.0.1
WS_PORT=3021

# Mail / SMTP
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sentra.pbltifnganjuk.com"
MAIL_FROM_NAME="${APP_NAME}"
